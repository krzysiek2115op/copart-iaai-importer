# /etc/iaai-importer.env  (skopiuj z tego wzoru i dostosuj)
# Ścieżki środowiskowe dla usług systemd. NIE wpisuj tu haseł do bazy —
# te scraper pobiera sam z wp-config.php przez iaai-env.sh.

# Katalog instalacji WordPressa (zawiera wp-config.php):
WP_PATH=/var/www/html

# Komenda/ścieżka WP-CLI:
WP_CLI=/usr/local/bin/wp

# Katalog z kodem scrapera (repo) na VPS:
SCRAPER_DIR=/opt/iaai-importer/scraper

# Punkt startowy wyszukiwarki IAAI (można zawęzić filtrami):
IAAI_BASE=https://www.iaai.com/Search

# Interpreter Pythona z zainstalowanymi zależnościami (playwright, pymysql, ...):
PYTHON=/opt/iaai-importer/.venv/bin/python
