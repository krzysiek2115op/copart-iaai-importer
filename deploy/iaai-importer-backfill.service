# /etc/systemd/system/iaai-importer-backfill.service
# Pełny przebieg (full + reconcile): synchronizuje całą bieżącą ofertę i oznacza
# znikłe loty jako sold/removed. Rzadko (np. raz na dobę) — uzupełnia tryb live.
[Unit]
Description=IAAI Importer — backfill full (pełna oferta + reconcile)
Wants=network-online.target
After=network-online.target mysql.service mariadb.service

[Service]
Type=oneshot
User=www-data
Group=www-data
EnvironmentFile=-/etc/iaai-importer.env
Environment=IAAI_MODE=full
ExecStart=/opt/iaai-importer/deploy/iaai-live-cycle.sh
TimeoutStartSec=10800
Nice=15
