# /etc/systemd/system/iaai-importer-live.timer
# Always-on: odpala cykl live cyklicznie. To jest serce automatyzacji —
# nowe auto na IAAI zostaje wyłapane bez udziału operatora.
[Unit]
Description=IAAI Importer — harmonogram cyklu live

[Timer]
# Pierwszy przebieg 5 min po starcie systemu:
OnBootSec=5min
# Kolejne co 15 min OD ZAKOŃCZENIA poprzedniego (nie nakłada się na siebie):
OnUnitInactiveSec=15min
# Nadrobienie po przestoju (np. po restarcie VPS):
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
