# SPDX-License-Identifier: GPL-2.0-or-later
# Poświadczenia i strojenie scrapera. Skopiuj do /etc/polea.env i USTAW chmod 600.
# NIGDY nie commituj pliku z realnym hasłem.

# --- Baza (osobna MySQL) ---
POLEA_DB_HOST=127.0.0.1
POLEA_DB_PORT=3306
POLEA_DB_USER=polea
POLEA_DB_PASSWORD=ZMIEN_MNIE
POLEA_DB_NAME=polea
# Opcjonalny TLS do zdalnej bazy:
# POLEA_DB_SSL_CA=/etc/ssl/certs/ca.pem

# --- Strojenie (opcjonalne; wartości domyślne w scraper/config.py) ---
# POLEA_DELAY=2.0
# POLEA_JITTER=1.0
# POLEA_MAX_PAGES=50
# POLEA_USER_AGENT=PoleasingoweImporter/0.1 (+kontakt)
# Próg bezpieczeństwa reconcile (0.5 = nie zamykaj masowo, gdy crawl widzi <50% aktywnych):
# POLEA_RECONCILE_MIN_RATIO=0.5
# Ścieżka blokady pojedynczej instancji (domyślnie w katalogu prywatnym użytkownika):
# POLEA_LOCK=/opt/polea/run/polea_import.lock
