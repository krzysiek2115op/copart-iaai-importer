        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;2. Nasz system (na serwerze)&lt;/b&gt;&lt;br&gt;Co kilka godzin automatycznie pobiera&lt;br&gt;i porządkuje oferty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="280" y="215" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;3. Baza danych ofert&lt;/b&gt;&lt;br&gt;Aktualne motocykle w jednym miejscu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="280" y="350" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="&lt;b&gt;4. Twoja strona WWW&lt;/b&gt;&lt;br&gt;Podstrona „Nasze motory” —&lt;br&gt;gotowa lista z filtrami i zdjęciami" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="280" y="475" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Zdjęcia pokazują się wprost&lt;br&gt;z poleasingowe.pl&lt;br&gt;(bez kopiowania na Twój serwer)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="475" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="Wszystko dzieje się automatycznie — nie musisz nic robić ręcznie." style="text;html=1;align=center;fontSize=13;fontStyle=2;" vertex="1" parent="1">
