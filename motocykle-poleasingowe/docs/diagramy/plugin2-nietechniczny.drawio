        <mxCell id="t1" value="Jak działa system „Nasze motory”" style="text;html=1;align=center;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="30" width="490" height="34" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;1. Portal poleasingowe.pl&lt;/b&gt;&lt;br&gt;Aukcje motocykli poleasingowych" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
