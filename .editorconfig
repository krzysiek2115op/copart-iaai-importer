# https://editorconfig.org — czyta to każdy sensowny edytor bez wtyczek.
# Po co: żeby diff pokazywał zmianę treści, a nie wojnę tabów ze spacjami.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{php,py}]
indent_size = 4

[*.md]
# W Markdownie dwie spacje na końcu linii to twardy podział wiersza.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
